# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign customer and admin session tokens.
# If omitted in local preview, a random ephemeral runtime secret is generated.
SESSION_SECRET=""

# ADMIN_SETUP_KEY: Optional setup passphrase required when creating the very first admin account.
ADMIN_SETUP_KEY=""
